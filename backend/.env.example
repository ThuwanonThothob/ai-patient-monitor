# Copy this file to backend/.env. Never commit backend/.env.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: use a different supported Gemini model.
GEMINI_MODEL=gemini-2.5-flash

# Optional Web Push. Disabled until the operator configures keys and HTTPS.
WARD_WEB_PUSH_ENABLED=0
# Generate with: python3 scripts/generate_push_keys.py
# WARD_VAPID_PRIVATE_KEY_FILE=/absolute/path/to/backend/runtime/webpush-private.pem
# WARD_VAPID_SUBJECT=mailto:your-real-contact@example.org
# Exact public HTTPS origins of your reverse proxy (different staff/patient hosts).
# WARD_STAFF_ORIGIN=https://staff.example.org
# WARD_PATIENT_ORIGIN=https://patient.example.org
# WARD_COOKIE_SECURE=1

# Create named staff/patient accounts with scripts/manage_account.py before
# disabling shared clinician and ID-only logins. This does not validate clinical use.
# WARD_DEMO_ID_LOGIN=0
# The requested fixed test_d/test_p accounts are created only for demonstrations.
# Disable for real-patient deployment. Private TEST uses the separate cloud profile.
# WARD_ENABLE_TEST_ACCOUNTS=0
# Private TEST: override BOTH local demo passwords (at least 16 characters).
# WARD_TEST_DOCTOR_PASSWORD=replace_with_unique_random_password
# WARD_TEST_PATIENT_PASSWORD=replace_with_another_random_password
# WARD_DB_PATH=/absolute/path/to/backend/runtime/ward-demo.db
# Internet-facing preflight intentionally fails unless all demo flags above are
# disabled, exact HTTPS origins are set, and real MQTT ingest is selected:
# .venv/bin/python scripts/deployment_preflight.py

# MQTT topic and safety timers for bedside vital/pressure-mat devices.
# WARD_INGEST_MODE=mqtt
# MQTT_BROKER=localhost
# MQTT_PORT=8083
# Set to 1 to receive bedside MQTT while keeping WARD_INGEST_MODE=replay.
# WARD_BEDSIDE_MQTT_ENABLED=1
# WARD_BEDSIDE_TOPIC=my_ai_hospital/bedside
# WARD_DEVICE_STALE_SECONDS=30
# WARD_TURN_REMINDER_SECONDS=7200

# Required only when exporting labelled pressure-mat features. Use a random
# deployment-specific value of at least 16 characters; never commit the real key.
# WARD_DATASET_EXPORT_KEY=replace_with_a_long_random_secret
