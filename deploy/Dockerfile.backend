FROM python:3.14-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
COPY --chown=10001:10001 deploy/requirements.lock.txt /app/deploy/requirements.lock.txt
RUN pip install --no-cache-dir -r /app/deploy/requirements.lock.txt \
    && groupadd --gid 10001 ward && useradd --uid 10001 --gid ward --no-create-home ward \
    && mkdir -p /var/lib/smart-ward /app/backend/models /app/backend/data/raw/bidmc \
    && chown -R ward:ward /var/lib/smart-ward /app
COPY --chown=10001:10001 backend/ /app/backend/
COPY --chown=10001:10001 scripts/deployment_preflight.py /app/scripts/deployment_preflight.py
COPY --chown=10001:10001 deploy/*.py /app/deploy/
WORKDIR /app/backend
USER 10001:10001
CMD ["python", "/app/deploy/run_api.py", "staff"]
