{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:staff",
    "dev:staff": "WARD_PORTAL=staff next dev --hostname 127.0.0.1 --port 3000",
    "dev:patient": "WARD_PORTAL=patient next dev --hostname 127.0.0.1 --port 3001",
    "build:patient": "WARD_PORTAL=patient next build --webpack",
    "build": "WARD_PORTAL=staff next build --webpack",
    "start": "npm run start:staff",
    "start:staff": "WARD_PORTAL=staff next start --hostname 127.0.0.1 --port 3000",
    "start:patient": "WARD_PORTAL=patient next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "ward:start": "../.venv/bin/python ../scripts/run_ward.py --start",
    "ward:restart": "../.venv/bin/python ../scripts/run_ward.py --restart",
    "ward:stop": "../.venv/bin/python ../scripts/run_ward.py --stop",
    "ward:status": "../.venv/bin/python ../scripts/run_ward.py --status"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
